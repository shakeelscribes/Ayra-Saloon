# Copy this file to ".env" and fill in your MongoDB connection string.
#
# Option 1 - MongoDB Atlas (cloud):
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/ayra_saloon?retryWrites=true&w=majority
#
# Option 2 - Local MongoDB:
# MONGODB_URL=mongodb://localhost:27017/ayra_saloon

# JWT signing secret — REQUIRED in production (rotating it logs everyone out).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed browser origins (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (calendar invites) ---
# Resend API key from resend.com → API Keys. Leave empty to disable email invites.
RESEND_API_KEY=
# resend = Resend REST API (recommended) | smtp = any SMTP server (fallback)
EMAIL_PROVIDER=resend
# Test mode: Resend's sandbox domain only delivers to YOUR account's inbox.
# After your domain is verified in Resend, change to: Ayra Salon <bookings@yourdomain.com>
EMAIL_FROM=Ayra Salon <onboarding@resend.dev>
